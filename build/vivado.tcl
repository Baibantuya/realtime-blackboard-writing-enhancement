# New candidate only: all three HLS cores regenerated with 2025.2.
# No bitstream or board actions. Original projects remain untouched.
# Preserve the first migration/failure. Short hierarchy avoids old nested output trees.
set here [file dirname [file dirname [file normalize [info script]]]]
if {![string match 2025.2* [version -short]]} {error "Expected Vivado 2025.2"}
set out [file join $here v]
if {[file exists $out]} {error "Existing candidate results retained"}
file mkdir [file join $out reports]
set_param general.maxThreads 4

foreach rel {h/r/s/impl/ip/component.xml h/s/s/impl/ip/component.xml h/w/s/impl/ip/component.xml} {
    if {![file isfile [file join $here $rel]]} {error "Run all three clean HLS builds first: $rel"}
}
create_project v24 [file join $out p] -part xck26-sfvc784-2LV-c
config_ip_cache -disable_cache
if {[get_property IP_CACHE_PERMISSIONS [current_project]] ne "disable"} {error "Clean build requires disabled IP cache"}
set_property target_language Verilog [current_project]
set_property XPM_LIBRARIES {XPM_MEMORY} [current_project]
set_property board_part xilinx.com:kv260_som:part0:1.2 [current_project]
set_property board_connections {som240_1_connector xilinx.com:kv260_carrier:som240_1_connector:1.2} [current_project]
set base [file join $here src pl]
set_property ip_repo_paths [list [file join $here h r s impl ip] [file join $here h w s impl ip] [file join $here h s s impl ip]] [current_project]
update_ip_catalog
add_files -norecurse [concat [glob [file join $base rtl *.v]] [glob [file join $base rtl *.sv]]]
set_property file_type SystemVerilog [get_files -quiet *.sv]
# Generated by the already completed native upgrade; no hand-changed version check.
set ::origin_dir_loc [file join $out b]
source [file join $here build design.tcl]
# pl_clk0 already has BUFG_PS; the wizard input is not a package pin.
set_property CONFIG.PRIM_SOURCE {No_buffer} [get_bd_cells clk_wiz_0]
if {[get_property CONFIG.PRIM_SOURCE [get_bd_cells clk_wiz_0]] ne "No_buffer"} {
    error "Clock Wizard did not retain the actual internal-clock source type"
}
validate_bd_design
save_bd_design
report_ip_status -file [file join $out reports ip_status.rpt]
write_bd_tcl [file join $out reports design.tcl]
generate_target all [get_files design_1.bd]
make_wrapper -files [get_files design_1.bd] -top -import
set_property top design_1_wrapper [current_fileset]
add_files -fileset constrs_1 -norecurse [file join $here build design_1_pin.xdc]
add_files -fileset constrs_1 -norecurse [file join $here build clock_source_jitter.xdc]
set_property PROCESSING_ORDER LATE [get_files clock_source_jitter.xdc]
update_compile_order -fileset sources_1
puts "CANDIDATE_GENERATION_COMPLETE"
set_property -name {STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS} -value {-control_set_opt_threshold 16} -objects [get_runs synth_1]
launch_runs synth_1 -jobs 1
set failed [catch {wait_on_runs synth_1} why]
set f [open [file join $out reports run_status.tsv] w]
foreach r [get_runs] {puts $f "$r\t[get_property STATUS $r]\t[get_property PROGRESS $r]"}
close $f
if {$failed} {error $why}
if {[get_property PROGRESS [get_runs synth_1]] ne "100%" || ![string match "*Complete*" [get_property STATUS [get_runs synth_1]]]} {error "Synthesis incomplete"}
open_run synth_1
# Check naturally generated constraints rather than deleting clocks after synthesis.
if {[llength [get_clocks -quiet clk_in1_design_1_clk_wiz_0_0]] != 0} {
    error "Unexpected duplicate primary clock persists"
}
foreach n {clk_out1_design_1_clk_wiz_0_0 clk_out2_video_design_1_clk_wiz_0_0 clk_out3_phy_design_1_clk_wiz_0_0} {
    set clk [get_clocks $n]
    if {[get_property PERIOD $clk] != 5.0 || [get_property MASTER_CLOCK $clk] ne "clk_pl_0"} {
        error "Unexpected clock frequency or master: $n"
    }
}
report_clocks -file [file join $out reports clocks.rpt]
report_utilization -file [file join $out reports utilization.rpt]
report_timing_summary -check_timing_verbose -report_unconstrained -file [file join $out reports timing.rpt]
report_drc -file [file join $out reports drc.rpt]
report_cdc -file [file join $out reports cdc.rpt]
write_checkpoint [file join $out reports synthesized.dcp]
puts "CLEAN_SYNTHESIS_COMPLETE_NOT_TIMING_PASS"
close_project

source [file join $here build implement.tcl]
