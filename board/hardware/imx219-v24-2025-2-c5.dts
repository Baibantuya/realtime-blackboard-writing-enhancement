					#size-cells = <0x00>;
					phandle = <0x34>;

					port@1 {
						reg = <0x01>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x35>;

						endpoint {
							remote-endpoint = <0x10>;
							phandle = <0x12>;
