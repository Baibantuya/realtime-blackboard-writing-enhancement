					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x13>;
							phandle = <0x15>;
						};
					};
				};
			};

			vcap_v_proc_ss_scaler {
				compatible = "xlnx,video";
				dma-names = "port0";
				dmas = <0x14 0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x37>;

					port@0 {
						reg = <0x00>;
						direction = "input";

						endpoint {
							remote-endpoint = <0x15>;
							phandle = <0x13>;
						};
					};
				};
