/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			firmware-name = "imx219-v24-2025-2-c5.bit.bin";
			resets = <0xffffffff 0x74>;
			phandle = <0x16>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			phandle = <0x17>;

			afi0 {
				compatible = "xlnx,afi-fpga";
				config-afi = <0x00 0x00 0x01 0x00 0x02 0x00 0x03 0x00 0x04 0x00 0x05 0x00 0x06 0x00 0x07 0x00 0x08 0x00 0x09 0x00 0x0a 0x00 0x0b 0x00 0x0c 0x00 0x0d 0x00 0x0e 0xa00 0x0f 0x00>;
				phandle = <0x18>;
			};

			clocking0 {
				#clock-cells = <0x00>;
				assigned-clock-rates = <0x5f5dd19>;
				assigned-clocks = <0xffffffff 0x47>;
				clock-output-names = "fabric_clk";
				clocks = <0xffffffff 0x47>;
				compatible = "xlnx,fclk";
				phandle = <0x19>;
			};

			clocking1 {
				#clock-cells = <0x00>;
				assigned-clock-rates = <0x5f5dd19>;
				assigned-clocks = <0xffffffff 0x48>;
				clock-output-names = "fabric_clk";
				clocks = <0xffffffff 0x48>;
				compatible = "xlnx,fclk";
				phandle = <0x1a>;
			};
		};
	};

	fragment@2 {
		target-path = [2f 00];

		__overlay__ {
			phandle = <0x1b>;

			fixedregulator0 {
				compatible = "regulator-fixed";
				regulator-name = "imx219_vana";
				regulator-min-microvolt = <0x2ab980>;
				regulator-max-microvolt = <0x2ab980>;
				phandle = <0x03>;
			};

			fixedregulator1 {
				compatible = "regulator-fixed";
				regulator-name = "imx219_vdig";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				phandle = <0x04>;
			};

			fixedregulator2 {
				compatible = "regulator-fixed";
				regulator-name = "imx219_vddl";
				regulator-min-microvolt = <0x124f80>;
				regulator-max-microvolt = <0x124f80>;
				phandle = <0x05>;
			};

			camera-clk {
				compatible = "fixed-clock";
				#clock-cells = <0x00>;
				clock-frequency = <0x16e3600>;
				phandle = <0x02>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			phandle = <0x1c>;

			i2c@80030000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-names = "s_axi_aclk";
				clocks = <0x01>;
				compatible = "xlnx,axi-iic-2.1\0xlnx,xps-iic-2.00.a";
				interrupt-names = "iic2intc_irpt";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x68 0x04>;
				reg = <0x00 0x80030000 0x00 0x10000>;
				phandle = <0x1d>;

				i2c_mux@74 {
					compatible = "nxp,pca9546";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x74>;
					phandle = <0x1e>;

					i2c@0 {
						reg = <0x00>;
						phandle = <0x1f>;
					};

					i2c@1 {
						reg = <0x01>;
						phandle = <0x20>;
					};

					i2c@2 {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x02>;
						phandle = <0x21>;

						sensor@10 {
							compatible = "sony,imx219";
							reg = <0x10>;
							clocks = <0x02>;
							VANA-supply = <0x03>;
							VDIG-supply = <0x04>;
							VDDL-supply = <0x05>;
							phandle = <0x22>;

							port {

								endpoint {
									remote-endpoint = <0x06>;
									data-lanes = <0x01 0x02>;
									clock-noncontinuous;
									link-frequencies = <0x00 0x1b2e0200>;
									phandle = <0x09>;
								};
							};
						};
					};
				};
			};

			misc_clk_0 {
				#clock-cells = <0x00>;
				clock-frequency = <0x5f5dd18>;
				compatible = "fixed-clock";
				phandle = <0x01>;
			};

			mipi_csi2_rx_subsystem@80002000 {
				clock-names = "lite_aclk\0dphy_clk_200M\0video_aclk";
				clocks = <0x01 0x07 0x07>;
				compatible = "xlnx,mipi-csi2-rx-subsystem-5.0";
				interrupt-names = "csirxss_csi_irq";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x69 0x04>;
				reg = <0x00 0x80002000 0x00 0x2000>;
				xlnx,axis-tdata-width = <0x08>;
				xlnx,csi-pxl-format = <0x2a>;
				xlnx,en-active-lanes;
				xlnx,en-csi-v2-0;
				xlnx,en-vcx;
				xlnx,max-lanes = <0x02>;
				xlnx,ppc = <0x01>;
				xlnx,vc = <0x04>;
				xlnx,vfb;
				phandle = <0x23>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x24>;

					port@1 {
						reg = <0x01>;
						xlnx,video-width = <0x08>;
						phandle = <0x25>;

						endpoint {
							remote-endpoint = <0x08>;
							phandle = <0x0b>;
						};
					};

					port@0 {
						reg = <0x00>;
						xlnx,video-width = <0x08>;
						phandle = <0x26>;

						endpoint {
							remote-endpoint = <0x09>;
							data-lanes = <0x01 0x02>;
							phandle = <0x06>;
						};
					};
				};
			};

			misc_clk_1 {
				#clock-cells = <0x00>;
				clock-frequency = <0xbebba30>;
				compatible = "fixed-clock";
				phandle = <0x07>;
			};

			v_demosaic@a0010000 {
				clock-names = "ap_clk";
				clocks = <0x07>;
				compatible = "xlnx,v-demosaic-1.1\0xlnx,v-demosaic";
				interrupt-names = "interrupt";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x6a 0x04>;
				reg = <0x00 0xa0010000 0x00 0x10000>;
				reset-gpios = <0xffffffff 0x4e 0x01>;
				xlnx,max-height = <0x438>;
				xlnx,max-width = <0x780>;
				xlnx,s-axi-ctrl-addr-width = <0x06>;
				xlnx,s-axi-ctrl-data-width = <0x20>;
				phandle = <0x27>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x28>;

					port@1 {
						reg = <0x01>;
						xlnx,video-width = <0x08>;
						phandle = <0x29>;

						endpoint {
							remote-endpoint = <0x0a>;
							phandle = <0x0d>;
						};
					};

					port@0 {
						reg = <0x00>;
						xlnx,video-width = <0x08>;
						phandle = <0x2a>;

						endpoint {
							remote-endpoint = <0x0b>;
							phandle = <0x08>;
						};
					};
				};
			};

			v_frmbuf_wr@a0020000 {
				#dma-cells = <0x01>;
				clock-names = "ap_clk";
				clocks = <0x07>;
				compatible = "xlnx,v-frmbuf-wr-2.4\0xlnx,axi-frmbuf-wr-v2.2";
				interrupt-names = "interrupt";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x6c 0x04>;
				reg = <0x00 0xa0020000 0x00 0x10000>;
				reset-gpios = <0xffffffff 0x52 0x01>;
				xlnx,dma-addr-width = <0x20>;
				xlnx,dma-align = <0x08>;
				xlnx,max-height = <0x7d0>;
				xlnx,max-width = <0xfa0>;
				xlnx,pixels-per-clock = <0x01>;
				xlnx,s-axi-ctrl-addr-width = <0x07>;
				xlnx,s-axi-ctrl-data-width = <0x20>;
				xlnx,vid-formats = "yuyv\0rgb888\0bgr888\0xbgr8888\0xrgb8888\0xbgr2101010\0vuy888\0xvuy8888\0nv12";
				xlnx,video-width = <0x08>;
				phandle = <0x14>;
			};

			v_gamma_lut@a0030000 {
				clock-names = "ap_clk";
				clocks = <0x07>;
				compatible = "xlnx,v-gamma-lut-1.1\0xlnx,v-gamma-lut";
				interrupt-names = "interrupt";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x6b 0x04>;
				reg = <0x00 0xa0030000 0x00 0x10000>;
				reset-gpios = <0xffffffff 0x4f 0x01>;
				xlnx,max-height = <0x438>;
				xlnx,max-width = <0x780>;
				xlnx,s-axi-ctrl-addr-width = <0x0d>;
				xlnx,s-axi-ctrl-data-width = <0x20>;
				phandle = <0x2b>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x2c>;

					port@1 {
						reg = <0x01>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x2d>;

						endpoint {
							remote-endpoint = <0x0c>;
							phandle = <0x0f>;
						};
					};

					port@0 {
						reg = <0x00>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x2e>;

						endpoint {
							remote-endpoint = <0x0d>;
							phandle = <0x0a>;
						};
					};
				};
			};

			v_proc_ss_csc@a0040000 {
				clock-names = "aclk";
				clocks = <0x07>;
				compatible = "xlnx,v-vpss-csc";
				reg = <0x00 0xa0040000 0x00 0x10000>;
				reset-gpios = <0xffffffff 0x50 0x01>;
				xlnx,colorspace-support = <0x01>;
				xlnx,max-height = <0x438>;
				xlnx,max-width = <0x780>;
				xlnx,num-video-components = <0x03>;
				xlnx,samples-per-clk = <0x01>;
				xlnx,use-uram = <0x00>;
				xlnx,video-width = <0x08>;
				phandle = <0x2f>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x30>;

					port@1 {
						reg = <0x01>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x31>;

						endpoint {
							remote-endpoint = <0x0e>;
							phandle = <0x11>;
						};
					};

					port@0 {
						reg = <0x00>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x32>;

						endpoint {
							remote-endpoint = <0x0f>;
							phandle = <0x0c>;
						};
					};
				};
			};

			v_proc_ss_scaler@a0080000 {
				clock-names = "aclk_axis\0aclk_ctrl";
				clocks = <0x07 0x07>;
				compatible = "xlnx,v-vpss-scaler-2.2";
				reg = <0x00 0xa0080000 0x00 0x40000>;
				reset-gpios = <0xffffffff 0x51 0x01>;
				xlnx,colorspace-support = <0x01>;
				xlnx,csc-enable-window = "true";
				xlnx,enable-csc = "false";
				xlnx,h-scaler-phases = <0x40>;
				xlnx,h-scaler-taps = <0x06>;
				xlnx,max-height = <0x438>;
				xlnx,max-num-phases = <0x40>;
				xlnx,max-width = <0x780>;
				xlnx,num-hori-taps = <0x06>;
				xlnx,num-vert-taps = <0x06>;
				xlnx,pix-per-clk = <0x01>;
				xlnx,samples-per-clk = <0x01>;
				xlnx,scaler-algorithm = <0x02>;
				xlnx,topology = <0x00>;
				xlnx,use-uram = <0x00>;
				xlnx,v-scaler-phases = <0x40>;
				xlnx,v-scaler-taps = <0x06>;
