					};

					port@0 {
						reg = <0x00>;
						xlnx,video-format = <0x02>;
						xlnx,video-width = <0x08>;
						phandle = <0x36>;

						endpoint {
							remote-endpoint = <0x11>;
							phandle = <0x0e>;
